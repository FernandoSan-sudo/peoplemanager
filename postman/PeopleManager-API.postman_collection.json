{
  "info": {
    "name": "PeopleManager API (esquema pm)",
    "description": "Colección de pruebas para la API de PeopleManager contra la base de datos real 'peoplemanager' (esquema pm): usuarios, catálogos, turnos, asistencia y solicitudes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "idUsuario", "value": "1" },
    { "key": "idTurno", "value": "1" },
    { "key": "idSolicitud", "value": "1" }
  ],
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/usuarios/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@peoplemanager.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Listar usuarios",
          "request": { "method": "GET", "url": "{{baseUrl}}/usuarios" }
        },
        {
          "name": "Obtener usuario por id",
          "request": { "method": "GET", "url": "{{baseUrl}}/usuarios/{{idUsuario}}" }
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero_documento\": \"1010101010\",\n  \"nombre_completo\": \"Empleado de Prueba\",\n  \"correo\": \"empleado.prueba@peoplemanager.com\",\n  \"password\": \"clave123\",\n  \"id_rol\": 3,\n  \"id_area\": 1\n}"
            }
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/usuarios/{{idUsuario}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_completo\": \"Nombre Actualizado\",\n  \"correo\": \"admin@peoplemanager.com\",\n  \"id_rol\": 1,\n  \"id_area\": null,\n  \"id_cargo\": null,\n  \"estado\": \"activo\"\n}"
            }
          }
        },
        {
          "name": "Eliminar usuario (lógico)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/usuarios/{{idUsuario}}" }
        }
      ]
    },
    {
      "name": "Catálogos",
      "item": [
        { "name": "Roles", "request": { "method": "GET", "url": "{{baseUrl}}/catalogos/roles" } },
        { "name": "Áreas", "request": { "method": "GET", "url": "{{baseUrl}}/catalogos/areas" } },
        { "name": "Cargos", "request": { "method": "GET", "url": "{{baseUrl}}/catalogos/cargos" } },
        { "name": "Tipos de solicitud", "request": { "method": "GET", "url": "{{baseUrl}}/catalogos/tipos-solicitud" } }
      ]
    },
    {
      "name": "Turnos",
      "item": [
        { "name": "Listar turnos", "request": { "method": "GET", "url": "{{baseUrl}}/turnos" } },
        { "name": "Listar turnos de un usuario", "request": { "method": "GET", "url": "{{baseUrl}}/turnos?id_usuario={{idUsuario}}" } },
        { "name": "Obtener turno por id", "request": { "method": "GET", "url": "{{baseUrl}}/turnos/{{idTurno}}" } },
        {
          "name": "Crear turno",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/turnos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_usuario\": 2,\n  \"fecha_turno\": \"2026-10-01\",\n  \"hora_inicio\": \"08:00\",\n  \"hora_fin\": \"17:00\",\n  \"id_area\": 1,\n  \"creado_por\": 1\n}"
            }
          }
        },
        {
          "name": "Actualizar turno",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/turnos/{{idTurno}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha_turno\": \"2026-10-02\",\n  \"hora_inicio\": \"09:00\",\n  \"hora_fin\": \"18:00\",\n  \"id_area\": 1\n}"
            }
          }
        },
        { "name": "Eliminar turno", "request": { "method": "DELETE", "url": "{{baseUrl}}/turnos/{{idTurno}}" } }
      ]
    },
    {
      "name": "Asistencia",
      "item": [
        {
          "name": "Registrar entrada",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/asistencia/entrada",
            "body": { "mode": "raw", "raw": "{\n  \"id_turno\": {{idTurno}},\n  \"id_usuario\": {{idUsuario}}\n}" }
          }
        },
        {
          "name": "Registrar salida",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/asistencia/salida",
            "body": { "mode": "raw", "raw": "{\n  \"id_turno\": {{idTurno}}\n}" }
          }
        },
        { "name": "Historial de asistencia de un usuario", "request": { "method": "GET", "url": "{{baseUrl}}/asistencia/usuario/{{idUsuario}}" } }
      ]
    },
    {
      "name": "Solicitudes",
      "item": [
        { "name": "Listar solicitudes", "request": { "method": "GET", "url": "{{baseUrl}}/solicitudes" } },
        { "name": "Listar solicitudes de un usuario", "request": { "method": "GET", "url": "{{baseUrl}}/solicitudes?id_usuario={{idUsuario}}" } },
        { "name": "Obtener solicitud por id", "request": { "method": "GET", "url": "{{baseUrl}}/solicitudes/{{idSolicitud}}" } },
        {
          "name": "Crear solicitud",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/solicitudes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_usuario\": 2,\n  \"id_tipo\": 1,\n  \"fecha_inicio\": \"2026-10-10\",\n  \"fecha_fin\": \"2026-10-11\",\n  \"motivo\": \"Cita médica\"\n}"
            }
          }
        },
        {
          "name": "Aprobar solicitud",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/solicitudes/{{idSolicitud}}/aprobar",
            "body": { "mode": "raw", "raw": "{\n  \"id_aprobador\": 1,\n  \"observacion_resp\": \"Aprobado\"\n}" }
          }
        },
        {
          "name": "Rechazar solicitud",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/solicitudes/{{idSolicitud}}/rechazar",
            "body": { "mode": "raw", "raw": "{\n  \"id_aprobador\": 1,\n  \"observacion_resp\": \"No cumple con los requisitos\"\n}" }
          }
        }
      ]
    }
  ]
}
